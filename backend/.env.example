PROJECT_NAME=LEVELX
PROJECT_SUBTITLE=by XFACTOR
VERSION=1.0.0
ENVIRONMENT=production
API_V1_STR=/api/v1

# CORS - Allowed origins (JSON array or comma-separated URLs)
CORS_ORIGINS=["https://levelx.dev","https://your-frontend-deployment.vercel.app","http://localhost:5173"]

# PostgreSQL / Neon Database Configuration (Required: ssl=require / sslmode=require for Neon)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>/<dbname>?ssl=require
SYNC_DATABASE_URL=postgresql://<username>:<password>@<host>/<dbname>?sslmode=require
